{
  "expo": {
    "name": "cy-tty",
    "slug": "cy-tty",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cytty",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.cytty"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141d41",
        "foregroundImage": "./assets/images/icon-tp.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cytty"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141d41",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
